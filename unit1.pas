unit Unit1;

{$mode objfpc}{$H+}

interface

uses
  Classes, SysUtils, Forms, Controls, Graphics, Dialogs, ExtCtrls, StdCtrls,
  ExtDlgs, math, LCLIntf;

type

  { TForm1 }

  TForm1 = class(TForm)
    Button1: TButton;
    Button2: TButton;
    Button3: TButton;
    Button4: TButton;
    EditR: TEdit;
    EditN: TEdit;
    Image1: TImage;
    Label1: TLabel;
    Label2: TLabel;
    OpenDialog1: TOpenDialog;
    OpenPictureDialog1: TOpenPictureDialog;
    Panel1: TPanel;
    SavePictureDialog1: TSavePictureDialog;
    procedure Button1Click(Sender: TObject);
    procedure Button2Click(Sender: TObject);
    procedure Button3Click(Sender: TObject);
    procedure Button4Click(Sender: TObject);
  private

  public

  end;

var
  Form1: TForm1;

implementation

{$R *.lfm}
{ --- ALGORITHM 1: DIGITAL DIFFERENTIAL ANALYZER (CDA / ЦДА) --- }
procedure cda(x1, y1, x2, y2: Real; canvas: TCanvas);
var
  i: Integer;
  l, dx, dy, x, y: Real;
begin
  // Check if start and end points are the same
  if (x1 = x2) and (y1 = y2) then
  begin
    canvas.Pixels[Floor(x1), Floor(y1)] := canvas.Pen.Color;
    Exit;
  end;

  // Determine the length of the line projection
  if Abs(x2 - x1) >= Abs(y2 - y1) then
    l := Abs(x2 - x1)
  else
    l := Abs(y2 - y1);

  // Calculate increment steps for each pixel
  dx := (x2 - x1) / l;
  dy := (y2 - y1) / l;

  // Initial pixel centering
  x := x1 + 0.5 * Sign(dx);
  y := y1 + 0.5 * Sign(dy);

  // Main drawing loop pixel by pixel
  for i := 1 to Round(l) + 1 do
  begin
    canvas.Pixels[Floor(x), Floor(y)] := canvas.Pen.Color;
    x := x + dx;
    y := y + dy;
  end;
end;
{ --- ALGORITHM 2: BRESENHAM FLOAT (БРЕЗЕНХЕМ С ВЕЩЕСТВЕННЫМИ ЧИСЛАМИ) --- }
procedure brezf(x1, y1, x2, y2: Real; canvas: TCanvas);
var
  i, sx, sy, f: Integer;
  e, dx, dy, x, y, t: Real;
begin
  // Check if start and end points are the same
  if (x1 = x2) and (y1 = y2) then
  begin
    canvas.Pixels[Floor(x1), Floor(y1)] := canvas.Pen.Color;
    Exit;
  end;

  sx := Sign(x2 - x1);
  sy := Sign(y2 - y1);
  dx := Abs(x2 - x1);
  dy := Abs(y2 - y1);
  x := x1;
  y := y1;
  f := 0;

  // Swap increments if the slope angle is greater than 45 degrees
  if dy > dx then
  begin
    t := dx;
    dx := dy;
    dy := t;
    f := 1;
  end;

  // Initialize decision error term
  e := (dy / dx) - 0.5;

  // Main drawing loop
  for i := 0 to Round(dx) do
  begin
    canvas.Pixels[Floor(x), Floor(y)] := canvas.Pen.Color;
    if e >= 0 then
    begin
      if f = 1 then x := x + sx else y := y + sy;
      e := e - 1;
    end;

    if f = 1 then y := y + sy else x := x + sx;
    e := e + (dy / dx);
  end;
end;
{ --- ALGORITHM 3: BRESENHAM INTEGER (ЦЕЛОЧИСЛЕННЫЙ БРЕЗЕНХЕМ) --- }
procedure brezi(x1, y1, x2, y2: Integer; canvas: TCanvas);
var
  t, i, sx, sy, f, dx, dy, x, y, e: Integer;
begin
  // Check if start and end points are the same
  if (x1 = x2) and (y1 = y2) then
  begin
    canvas.Pixels[x1, y1] := canvas.Pen.Color;
    Exit;
  end;

  sx := Sign(x2 - x1);
  sy := Sign(y2 - y1);
  dx := Abs(x2 - x1);
  dy := Abs(y2 - y1);
  x := x1;
  y := y1;
  f := 0;

  // Swap increments if the slope angle is greater than 45 degrees
  if dy > dx then
  begin
    t := dx;
    dx := dy;
    dy := t;
    f := 1;
  end;

  // Initialize decision error term using integer bit shifts
  e := (2 * dy) - dx;

  // Main drawing loop
  for i := 0 to dx do
  begin
    canvas.Pixels[x, y] := canvas.Pen.Color;
    if e >= 0 then
    begin
      if f = 1 then x := x + sx else y := y + sy;
      e := e - (2 * dx);
    end;

    if f = 1 then y := y + sy else x := x + sx;
    e := e + (2 * dy);
  end;
end;



{ TForm1 }

procedure TForm1.Button1Click(Sender: TObject);
var
  i, n, r: Integer;
  alph, x1, x2, y1, y2: Real;
  SvgFile: TextFile;
begin
  with Image1.Picture.Bitmap do
  begin
    Clear;
    PixelFormat := pf24bit;

    r := StrToIntDef(EditR.Text, 150);
    n := StrToIntDef(EditN.Text, 8);

    Width := (r * 2) + 60;
    Height := (r * 2) + 60;

    Canvas.Brush.Color := clWhite;
    Canvas.Brush.Style := bsSolid;
    Canvas.FillRect(0, 0, Width, Height);

    // --- PREPARE SYSTEM AUTOGENERATED SVG FILE ---
    AssignFile(SvgFile, 'etoile_parfaite.svg');
    Rewrite(SvgFile);
    Writeln(SvgFile, Format('<svg width="%d" height="%d">', [Width, Height]));

    alph := (2 * 3.14159265) / n;

    for i := 0 to n - 1 do
    begin
      x1 := (Width / 2) + (r * Cos(i * alph));
      y1 := (Height / 2) + (r * Sin(i * alph));

      x2 := (Width / 2) + (r * Cos(((i + 3) mod n) * alph));
      y2 := (Height / 2) + (r * Sin(((i + 3) mod n) * alph));

      // Save perfect coordinate node link straight into the SVG template file
      Writeln(SvgFile, Format('  <line x1="%.1f" y1="%.1f" x2="%.1f" y2="%.1f" />', [x1, y1, x2, y2]));

      // Standard layers display
      Canvas.Pen.Color := RGB(100, 100, 255);
      cda(x1, y1, x2, y2, Canvas);

      Canvas.Pen.Color := RGB(255, 100, 100);
      brezf(x1, y1, x2, y2, Canvas);

      Canvas.Pen.Color := RGB(100, 255, 100);
      brezi(Round(x1), Round(y1), Round(x2), Round(y2), Canvas);

      Canvas.Pen.Color := RGB(60, 60, 60);
      Canvas.Line(Round(x1), Round(y1), Round(x2), Round(y2));
    end;

    Writeln(SvgFile, '</svg>');
    CloseFile(SvgFile);
  end;

  Image1.Invalidate;
end;

procedure TForm1.Button2Click(Sender: TObject);
begin
  begin
  // Set file filter options for saving the image
  SavePictureDialog1.Filter := 'Bitmap Image (*.bmp)|*.bmp|PNG Image (*.png)|*.png';

  // If the user chooses a location and file name, save it
  if SavePictureDialog1.Execute then
  begin
    Image1.Picture.SaveToFile(SavePictureDialog1.FileName);
    ShowMessage('Star image saved successfully!');
  end;
end;
end;

procedure TForm1.Button3Click(Sender: TObject);
var
  SvgFile: TextFile;
  LineText: String;
  x1, y1, x2, y2: Real;
  R: Integer;

  // Helper function to extract numeric values from XML attributes
  function ExtractAttr(const Line, AttrName: String): Real;
  var
    PosAttr, PosStart, PosEnd: Integer;
    ValueStr: String;
  begin
    Result := 0;
    PosAttr := Pos(AttrName + '="', Line);
    if PosAttr > 0 then
    begin
      PosStart := PosAttr + Length(AttrName) + 2;
      ValueStr := Copy(Line, PosStart, MaxInt);
      PosEnd := Pos('"', ValueStr);
      if PosEnd > 0 then
      begin
        ValueStr := Copy(ValueStr, 1, PosEnd - 1);
        Result := StrToFloatDef(ValueStr, 0);
      end;
    end;
  end;

begin
  // FIXED: Using OpenDialog1 instead of OpenPictureDialog1 to bypass the extension restriction
  OpenDialog1.Filter := 'Scalable Vector Graphics (*.svg)|*.svg';

  if OpenDialog1.Execute then
  begin
    with Image1.Picture.Bitmap do
    begin
      Clear;
      PixelFormat := pf24bit;

      // Dynamic dimensions matching exactly the creation size for perfect centering
      R := StrToIntDef(EditR.Text, 150);
      Width := (R * 2) + 60;
      Height := (R * 2) + 60;

      // Clear background to solid white
      Canvas.Brush.Color := clWhite;
      Canvas.Brush.Style := bsSolid;
      Canvas.FillRect(0, 0, Width, Height);

      // Open and read the SVG file line by line
      AssignFile(SvgFile, OpenDialog1.FileName);
      Reset(SvgFile);
      try
        while not Eof(SvgFile) do
        begin
          Readln(SvgFile, LineText);

          // If the line contains a vector segment definition
          if Pos('<line', LineText) > 0 then
          begin
            x1 := ExtractAttr(LineText, 'x1');
            y1 := ExtractAttr(LineText, 'y1');
            x2 := ExtractAttr(LineText, 'x2');
            y2 := ExtractAttr(LineText, 'y2');

            // Layer 1: Blue pixels with CDA Algorithm
            Canvas.Pen.Color := RGB(100, 100, 255);
            cda(x1, y1, x2, y2, Canvas);

            // Layer 2: Red pixels with Floating Bresenham
            Canvas.Pen.Color := RGB(255, 100, 100);
            brezf(x1, y1, x2, y2, Canvas);

            // Layer 3: Green pixels with Integer Bresenham
            Canvas.Pen.Color := RGB(100, 255, 100);
            brezi(Round(x1), Round(y1), Round(x2), Round(y2), Canvas);

            // Layer 4: Dark Grey accents using native vector system
            Canvas.Pen.Color := RGB(60, 60, 60);
            Canvas.Line(Round(x1), Round(y1), Round(x2), Round(y2));
          end;
        end;
      finally
        CloseFile(SvgFile);
      end;
    end;

    // Refresh display frame
    Image1.Invalidate;
  end;
end;


procedure TForm1.Button4Click(Sender: TObject);
var
  PbmFile: TextFile;
  px, py: Integer;
  CurrentColor: TColor;
  BinaryValue: Char;
  W, H: Integer;
begin
  // Get current dimensions directly from the live bitmap
  W := Image1.Picture.Bitmap.Width;
  H := Image1.Picture.Bitmap.Height;

  // FIXED SAFETY CHECK: Ensure dimensions are properly initialized
  if (W <= 0) or (H <= 0) then
  begin
    ShowMessage('Please render the star from SVG or Create it first!');
    Exit;
  end;

  // Set filter specifically for PBM plain text files
  SavePictureDialog1.Filter := 'Portable Bitmap (*.pbm)|*.pbm';
   // Forces the dialog to open directly in the folder where the program is running
  SavePictureDialog1.InitialDir := ExtractFilePath(Application.ExeName);

  if SavePictureDialog1.Execute then
  begin
    // Link the file variable to the chosen filename and open it for writing
    AssignFile(PbmFile, SavePictureDialog1.FileName);
    Rewrite(PbmFile);
    try
      // Write the PBM ASCII header (P1 format specification, Width, Height)
      Writeln(PbmFile, 'P1');
      Writeln(PbmFile, IntToStr(W) + ' ' + IntToStr(H));

      // Process every pixel row by row from top to bottom
      for py := 0 to H - 1 do
      begin
        for px := 0 to W - 1 do
        begin
          // Get the exact color of the current pixel position
          CurrentColor := Image1.Picture.Bitmap.Canvas.Pixels[px, py];

          // In standard plaintext PBM, '0' represents White and '1' represents Color
          if CurrentColor = clWhite then
            BinaryValue := '0'
          else
            BinaryValue := '1';

          // Write the digit followed by a space separator
          Write(PbmFile, BinaryValue + ' ');
        end;
        Writeln(PbmFile); // Move to a new line at the end of each pixel row
      end;
    finally
      // Close the file stream cleanly to write changes to disk
      CloseFile(PbmFile);
    end;
    ShowMessage('Vector image successfully exported to PBM text format!');
  end;
end;


end.

